APP_NAME="CivicFix AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-backend-url.onrender.com
FRONTEND_URL=https://your-vercel-project.vercel.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-railway-public-mysql-host
DB_PORT=your-railway-public-mysql-port
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your_railway_mysql_password

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=your-vercel-project.vercel.app
SESSION_DOMAIN=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@civicfix.local
MAIL_FROM_NAME="CivicFix AI"

FILESYSTEM_DISK=public